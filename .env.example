# Local mocks — do not put real production secrets here.
# Supabase is not wired in this MVP. Auth uses /api/auth/magic-link.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=mock-supabase-service-role

# Resend is not wired. Express interest is stored in memory on the API route.
RESEND_API_KEY=re_mock_resend_key
HOST_INBOX_EMAIL=host@localhost

# Admin unlock on /admin/jobs (also hardcoded as local-dev-admin for local demo).
ADMIN_SECRET=local-dev-admin
